# ==================================
# eLISAschool - Configuration Reseau Local
# ==================================
# Copiez ce fichier en .env.local et remplissez les valeurs
#   cp .env.local.example .env.local
#
# Deploiement :
#   ./deploy.sh local-dev up     # Developpement (hot-reload)
#   ./deploy.sh local-prod up    # Production locale
#
# L'IP du serveur est auto-detectee par deploy.sh.
# Pour forcer une IP : HOST_IP=192.168.1.100
# ==================================

# --- RESEAU ---
# IP du serveur (auto-detectee si vide)
# HOST_IP=

# --- PORTS ---
FRONTEND_PORT=7001
BACKEND_PORT=7000
DB_PORT=7002
REDIS_PORT=7003
PGADMIN_PORT=7004

# --- APPLICATION ---
NODE_ENV=development
APP_NAME=eLISAschool

# --- BASE DE DONNEES ---
DB_NAME=elisaschool
DB_USER=elisaschool_user
DB_PASSWORD=change_this_password

# --- JWT (auto-genere si vide en dev, min 32 chars) ---
JWT_SECRET=
# Dual-plane JWT secrets (v10.1)
# En dev : auto-générés distincts si vides
# En production : OBLIGATOIRES (pas de fallback)
JWT_SECRET_PLATFORM=
JWT_SECRET_TENANT=
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# --- CHIFFREMENT (auto-genere si vide en dev, 32 chars) ---
ENCRYPTION_KEY=

# --- REDIS ---
REDIS_PASSWORD=

# --- pgAdmin ---
PGADMIN_EMAIL=admin@elisaschool.cm
PGADMIN_PASSWORD=admin123

# --- CORS (auto-configure par deploy.sh) ---
# FRONTEND_URL et ALLOWED_ORIGINS sont configures automatiquement
# par deploy.sh en fonction de l'IP detectee.
# FRONTEND_URL=
# ALLOWED_ORIGINS=

# --- EMAIL (SMTP) - Optionnel ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@elisaschool.cm

# --- LOGGING ---
LOG_LEVEL=debug

# --- CRON JOBS ---
ENABLE_CRON_JOBS=true
