# ==================================
# eLISAschool - Configuration Cloud (VPS)
# ==================================
# Copiez ce fichier en .env.cloud et remplissez les valeurs
#   cp .env.cloud.example .env.cloud
#
# Deploiement :
#   ./deploy.sh cloud-dev up     # Dev avec domaine (sans SSL)
#   ./deploy.sh cloud-prod up    # Production (HTTPS automatique)
#
# Prerequis :
#   - Un domaine (ex: app.elisaschool.cm) pointant vers l'IP du VPS
#   - Docker + Docker Compose installes sur le VPS
# ==================================

# --- MODE ---
NODE_ENV=production

# --- DOMAINES ---
DOMAIN_NAME=app.elisaschool.cm

# --- PORTS ---
FRONTEND_PORT=7001
BACKEND_PORT=7000
DB_PORT=7002
REDIS_PORT=7003

# --- SSL/TLS ---
SSL_MODE=auto

# --- BASE DE DONNEES (auto-genere si __AUTO_GENERATE__) ---
DB_NAME=elisaschool_prod
DB_USER=elisaschool_user
DB_PASSWORD=__AUTO_GENERATE__

# --- JWT (auto-genere, min 64 chars en prod) ---
JWT_SECRET=__AUTO_GENERATE__
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# --- CHIFFREMENT (auto-genere, 32 chars) ---
ENCRYPTION_KEY=__AUTO_GENERATE__

# --- REDIS ---
REDIS_PASSWORD=__AUTO_GENERATE__

# --- CORS (auto-configure avec le domaine) ---
# Ajouter des origines supplementaires si necessaire (separees par virgules)
ALLOWED_ORIGINS=

# --- pgAdmin (desactive en production cloud) ---
PGADMIN_ENABLED=false
PGADMIN_EMAIL=admin@elisaschool.cm
PGADMIN_PASSWORD=__AUTO_GENERATE__

# --- EMAIL (SMTP) ---
SMTP_HOST=smtp.elisaschool.cm
SMTP_PORT=587
SMTP_USER=noreply@elisaschool.cm
SMTP_PASSWORD=
SMTP_FROM=noreply@elisaschool.cm

# --- ADMIN ---
ADMIN_EMAIL=admin@elisaschool.cm

# --- LOGGING ---
LOG_LEVEL=info

# --- CRON JOBS ---
ENABLE_CRON_JOBS=true

# --- BACKUPS ---
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=30
