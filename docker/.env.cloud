# ==================================
# eLISAschool - Configuration Cloud
# ==================================
# Version: 1.0.0
# Auteur: franck arlos chendjou
#
# Pour déploiement sur serveur cloud avec domaine

# ==================================
# MODE
# ==================================
NODE_ENV=production

# ==================================
# APPLICATION
# ==================================
APP_NAME=eLISAschool
APP_PORT=7000
FRONTEND_PORT=7001
DB_PORT=7002
REDIS_PORT=7003
PGADMIN_PORT=7004

# ==================================
# DOMAINE
# ==================================
DOMAIN_NAME=app.elisaschool.cm
APP_URL=https://app.elisaschool.cm

# ==================================
# SSL/TLS
# ==================================
# auto = Let's Encrypt automatique
# manual = Certificats manuels (entreprise)
SSL_MODE=auto
SSL_CERT_PATH=
SSL_KEY_PATH=

# ==================================
# BASE DE DONNÉES
# ==================================
DB_NAME=elisaschool_prod
DB_USER=elisaschool_user
DB_PASSWORD=__AUTO_GENERATE__

# ==================================
# REDIS
# ==================================
REDIS_PASSWORD=__AUTO_GENERATE__

# ==================================
# JWT
# ==================================
JWT_SECRET=__AUTO_GENERATE__
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ==================================
# CHIFFREMENT
# ==================================
ENCRYPTION_KEY=__AUTO_GENERATE__

# ==================================
# CORS
# ==================================
FRONTEND_URL=https://app.elisaschool.cm
ALLOWED_ORIGINS=

# ==================================
# EMAIL (SMTP)
# ==================================
SMTP_HOST=smtp.elisaschool.cm
SMTP_PORT=587
SMTP_USER=noreply@elisaschool.cm
SMTP_PASSWORD=
SMTP_FROM=noreply@elisaschool.cm

# ==================================
# SMS (Twilio) - Optionnel
# ==================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ==================================
# PUSH NOTIFICATIONS (Firebase) - Optionnel
# ==================================
FIREBASE_PROJECT_ID=
FIREBASE_SERVER_KEY=
FIREBASE_VAPID_KEY=

# ==================================
# LOGGING
# ==================================
LOG_LEVEL=info
LOG_FILE=logs/app.log

# ==================================
# CRON JOBS
# ==================================
ENABLE_CRON_JOBS=true

# ==================================
# pgAdmin (désactivé en production cloud)
# ==================================
PGADMIN_ENABLED=false
PGADMIN_EMAIL=admin@elisaschool.cm
PGADMIN_PASSWORD=__AUTO_GENERATE__

# ==================================
# EMAIL ADMIN
# ==================================
ADMIN_EMAIL=admin@elisaschool.cm

# ==================================
# BACKUPS
# ==================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_EXTERNAL_PATH=

# ==================================
# MONITORING
# ==================================
MONITORING_ENABLED=true
MONITORING_ALERT_EMAIL=admin@elisaschool.cm

# ==================================
# MISES À JOUR
# ==================================
UPDATE_AUTO_CHECK=true
UPDATE_AUTO_DOWNLOAD=false
UPDATE_AUTO_APPLY=false
UPDATE_NOTIFICATION_EMAIL=admin@elisaschool.cm
