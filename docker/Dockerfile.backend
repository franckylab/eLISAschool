# ==================================
# eLISAschool Backend - Dockerfile
# ==================================
# Utilisé pour la PRODUCTION uniquement
# Pour le développement : utiliser docker/Dockerfile.backend.dev

# ==================================
# Étape 1: Base commune
# ==================================
FROM node:20-alpine AS base
WORKDIR /app
RUN apk add --no-cache libc6-compat

# ==================================
# Étape 2: Installation des dépendances (monorepo workspaces)
# ==================================
FROM base AS deps
# Copie des fichiers de dépendances (monorepo workspaces)
COPY package.json package-lock.json ./
COPY backend/package.json ./backend/
COPY shared/package.json ./shared/
# Création des répertoires workspace pour npm
RUN mkdir -p backend shared
# Installation de toutes les dépendances (dev + prod)
RUN npm install

# ==================================
# Étape 3: Build TypeScript (production uniquement)
# ==================================
FROM base AS builder
COPY --from=deps /app/node_modules ./node_modules
COPY package.json package-lock.json ./
COPY backend/ ./backend/
COPY shared/ ./shared/
# Build du shared puis du backend
RUN npm run build --workspace=shared && npm run build --workspace=backend

# ==================================
# Étape 4: Image de production (finale)
# ==================================
FROM node:20-alpine AS production
WORKDIR /app
RUN apk add --no-cache libc6-compat
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 expressjs

# Copie des dépendances de production uniquement
COPY package.json package-lock.json ./
COPY backend/package.json ./backend/
COPY shared/package.json ./shared/
RUN mkdir -p backend shared && npm ci --omit=dev && npm cache clean --force

# Copie des builds compilés
COPY --from=builder /app/shared/dist ./shared/dist
COPY --from=builder /app/backend/dist ./backend/dist

# Configuration
ENV NODE_ENV=production
ENV PORT=7000
USER expressjs
EXPOSE 7000

# Commande par défaut (production)
CMD ["node", "backend/dist/index.js"]
