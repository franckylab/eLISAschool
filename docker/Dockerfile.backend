# ==================================
# eLISAschool Backend - Dockerfile
# ==================================
# Utilisé pour la production ET le développement
# En dev: docker-compose.dev.yml override la commande et monte les volumes
# En prod: build multi-stage, exécution du JS compilé

# ==================================
# Étape 1: Base commune
# ==================================
FROM node:20-alpine AS base
WORKDIR /app
RUN apk add --no-cache libc6-compat

# ==================================
# Étape 2: Installation des dépendances (monorepo workspaces)
# ==================================
FROM base AS deps
# Copie des fichiers de dépendances (monorepo workspaces)
COPY package.json package-lock.json ./
COPY backend/package.json ./backend/
COPY shared/package.json ./shared/
# Création des répertoires workspace pour npm
RUN mkdir -p backend shared
# Installation de toutes les dépendances (dev + prod)
RUN npm ci

# ==================================
# Étape 3: Build TypeScript (production uniquement)
# ==================================
FROM base AS builder
COPY --from=deps /app/node_modules ./node_modules
COPY package.json package-lock.json ./
COPY backend/ ./backend/
COPY shared/ ./shared/
# Build du shared puis du backend
RUN npm run build --workspace=shared && npm run build --workspace=backend

# ==================================
# Étape 4: Image de production (finale)
# ==================================
FROM node:20-alpine AS production
WORKDIR /app
RUN apk add --no-cache libc6-compat
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 expressjs

# Copie des dépendances de production uniquement
COPY package.json package-lock.json ./
COPY backend/package.json ./backend/
COPY shared/package.json ./shared/
RUN mkdir -p backend shared && npm ci --omit=dev && npm cache clean --force

# Copie des builds compilés
COPY --from=builder /app/shared/dist ./shared/dist
COPY --from=builder /app/backend/dist ./backend/dist

# Configuration
ENV NODE_ENV=production
ENV PORT=3000
USER expressjs
EXPOSE 3000

# Commande par défaut (production)
CMD ["node", "backend/dist/index.js"]

# ==================================
# Étape 5: Image de développement
# ==================================
FROM base AS development
WORKDIR /app

# Copie de TOUT node_modules depuis deps (npm workspaces hoist tout à la racine)
COPY --from=deps /app/node_modules ./node_modules

# Copie du code source (sera remplacé par le volume monté en dev)
COPY package.json package-lock.json ./
COPY backend/ ./backend/
COPY shared/ ./shared/

# Nodemon est installé via les devDependencies
ENV NODE_ENV=development
ENV PORT=3000
EXPOSE 3000

# Commande par défaut (développement avec hot-reload)
CMD ["npx", "nodemon", "--config", "backend/nodemon.json"]
