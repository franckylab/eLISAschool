# ==================================
# eLISAschool - Configuration Production Redis
# ==================================
# Ce fichier montre comment configurer Redis pour la production
# 
# Pour activer cette configuration :
# 1. Définir REDIS_PASSWORD dans .env
# 2. Redémarrer Docker : npm run docker:prod:build
# ==================================

# APPLICATION
# ------------
NODE_ENV=production
APP_NAME=eLISAschool
APP_VERSION=1.0.0
APP_PORT=7000
APP_URL=https://votre-domaine.cm

# BASE DE DONNÉES
# ---------------
DB_HOST=postgres
DB_PORT=7002
DB_NAME=elisaschool_prod
DB_USER=elisaschool_user
DB_PASSWORD=votre_mot_de_passe_db_tres_securise

# JWT
# ---
JWT_SECRET=votre_jwt_secret_production_64 caracteres_minimum_tres_securise
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# CHIFFREMENT
# -----------
ENCRYPTION_KEY=votre_cle_aes_256_exactement_32_caracteres

# REDIS (PRODUCTION)
# ------------------
# IMPORTANT : Définir un mot de passe fort pour Redis en production
REDIS_HOST=redis
REDIS_PORT=7003
REDIS_PASSWORD=redis_prod_password_2024_tres_securise_32chars

# EMAIL
# -----
SMTP_HOST=smtp.votre-provider.com
SMTP_PORT=587
SMTP_USER=noreply@votre-domaine.cm
SMTP_PASSWORD=votre_mot_de_passe_smtp
SMTP_FROM=noreply@votre-domaine.cm

# FRONTEND
# --------
FRONTEND_URL=https://app.votre-domaine.cm

# LICENCE
# -------
LICENSE_KEY=votre-cle-de-licence-production

# LOGGING
# -------
LOG_LEVEL=info
LOG_FILE=logs/app.log
