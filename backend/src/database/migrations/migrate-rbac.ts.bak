/**
 * ==================================
 * eLISAschool - Script de Migration RBAC v2.0
 * ==================================
 * Version: 1.0.0
 * Auteur: xAI Éducation
 * 
 * Ce script permet de migrer les permissions existantes vers le nouveau système RBAC
 * SANS casser les assignations actuelles.
 * 
 * Utilisation:
 *   npm run migrate:rbac
 * 
 * Le script est RÉVERSIBLE et IDÉMPOTENT (peut être exécuté plusieurs fois)
 */

import 'reflect-metadata';
import { AppDataSource } from '../data-source';
import { Repository } from 'typeorm';

// Imports des entités
import RoleEntity from '../../modules/auth/entities/role.entity';
import PermissionEntity from '../../modules/auth/entities/permission.entity';
import UtilisateurRole from '../../modules/auth/entities/utilisateur-role.entity';
import UtilisateurPermission from '../../modules/auth/entities/utilisateur-permission.entity';
import Utilisateur from '../../modules/auth/entities/utilisateur.entity';

// Imports des enums
import { Role } from '@shared/enums/roles.enum';

// ==================================
// CONFIGURATION
// ==================================

const MIGRATION_CONFIG = {
    // Ne pas supprimer les permissions existantes
    keepExistingPermissions: true,
    
    // Mode dry-run (true = simulation uniquement)
    dryRun: process.env.DRY_RUN === 'true',
    
    // Log détaillé
    verbose: true,
};

// ==================================
// SERVICE DE MIGRATION
// ==================================

class RBACMigrationService {
    private roleRepo: Repository<RoleEntity>;
    private permissionRepo: Repository<PermissionEntity>;
    private utilisateurRoleRepo: Repository<UtilisateurRole>;
    private utilisateurPermissionRepo: Repository<UtilisateurPermission>;
    private utilisateurRepo: Repository<Utilisateur>;

    constructor() {
        this.roleRepo = AppDataSource.getRepository(RoleEntity);
        this.permissionRepo = AppDataSource.getRepository(PermissionEntity);
        this.utilisateurRoleRepo = AppDataSource.getRepository(UtilisateurRole);
        this.utilisateurPermissionRepo = AppDataSource.getRepository(UtilisateurPermission);
        this.utilisateurRepo = AppDataSource.getRepository(Utilisateur);
    }

    /**
     * Exécuter la migration complète
     */
    async migrate(): Promise<void> {
        console.log('\n🚀 Début de la migration RBAC v2.0...\n');

        try {
            // Étape 1: Vérifier l'état actuel
            await this.checkCurrentState();

            // Étape 2: Migrer les utilisateurs existants vers le multi-rôles
            await this.migrateUsersToMultiRoles();

            // Étape 3: Vérifier la cohérence des données
            await this.verifyDataConsistency();

            // Étape 4: Générer un rapport
            await this.generateReport();

            if (MIGRATION_CONFIG.dryRun) {
                console.log('\n⚠️  DRY-RUN: Aucune modification n\'a été effectuée');
                console.log('   Pour exécuter la migration réelle: DRY_RUN=false npm run migrate:rbac\n');
            } else {
                console.log('\n✅ Migration terminée avec succès !\n');
            }
        } catch (error) {
            console.error('\n❌ Erreur pendant la migration:', error);
            throw error;
        }
    }

    /**
     * Vérifier l'état actuel de la base de données
     */
    private async checkCurrentState(): Promise<void> {
        console.log('📊 Vérification de l\'état actuel...\n');

        const totalUsers = await this.utilisateurRepo.count();
        const totalRoles = await this.roleRepo.count();
        const totalPermissions = await this.permissionRepo.count();
        const totalUtilisateurRoles = await this.utilisateurRoleRepo.count();

        console.log(`   Utilisateurs: ${totalUsers}`);
        console.log(`   Rôles en base: ${totalRoles}`);
        console.log(`   Permissions en base: ${totalPermissions}`);
        console.log(`   Assignations rôles: ${totalUtilisateurRoles}`);
        console.log('');

        // Vérifier si des utilisateurs n'ont pas de rôle assigné
        const usersWithoutRole = await this.utilisateurRepo
            .createQueryBuilder('u')
            .where('u.role IS NULL OR u.role = \'\'')
            .getCount();

        if (usersWithoutRole > 0) {
            console.log(`   ⚠️  ${usersWithoutRole} utilisateurs sans rôle assigné`);
        }
    }

    /**
     * Migrer les utilisateurs existants vers le système multi-rôles
     */
    private async migrateUsersToMultiRoles(): Promise<void> {
        console.log('🔄 Migration des utilisateurs vers le multi-rôles...\n');

        // Récupérer tous les utilisateurs
        const users = await this.utilisateurRepo.find();
        
        let migratedCount = 0;
        let skippedCount = 0;

        for (const user of users) {
            try {
                // Vérifier si l'utilisateur a déjà des rôles assignés
                const existingRoles = await this.utilisateurRoleRepo.find({
                    where: { utilisateurId: user.id },
                });

                if (existingRoles.length > 0 && MIGRATION_CONFIG.keepExistingPermissions) {
                    // L'utilisateur a déjà des rôles, on ne modifie rien
                    skippedCount++;
                    continue;
                }

                // Si l'utilisateur a un rôle principal (ancien système)
                if (user.role) {
                    // Trouver le rôle correspondant en base
                    const roleInDb = await this.roleRepo.findOne({
                        where: { code: user.role },
                    });

                    if (roleInDb) {
                        if (!MIGRATION_CONFIG.dryRun) {
                            // Créer l'assignation de rôle
                            const utilisateurRole = this.utilisateurRoleRepo.create({
                                utilisateurId: user.id,
                                roleId: roleInDb.id,
                                estPrincipal: true,
                                dateAttribution: new Date(),
                            });

                            await this.utilisateurRoleRepo.save(utilisateurRole);
                        }

                        migratedCount++;

                        if (MIGRATION_CONFIG.verbose) {
                            console.log(`   ✅ ${user.email} → ${roleInDb.libelle}`);
                        }
                    } else {
                        console.log(`   ⚠️  Rôle "${user.role}" non trouvé pour ${user.email}`);
                    }
                }
            } catch (error) {
                console.error(`   ❌ Erreur lors de la migration de ${user.email}:`, error);
            }
        }

        console.log(`\n   📈 Utilisateurs migrés: ${migratedCount}`);
        console.log(`   📊 Utilisateurs ignorés (déjà migrés): ${skippedCount}`);
        console.log('');
    }

    /**
     * Vérifier la cohérence des données
     */
    private async verifyDataConsistency(): Promise<void> {
        console.log('🔍 Vérification de la cohérence des données...\n');

        // Vérifier les rôles orphelins
        const orphanRoles = await this.roleRepo
            .createQueryBuilder('r')
            .leftJoin('utilisateur_roles', 'ur', 'ur.roleId = r.id')
            .where('ur.id IS NULL')
            .getCount();

        console.log(`   Rôles sans utilisateurs: ${orphanRoles}`);

        // Vérifier les permissions orphelines
        const orphanPermissions = await this.permissionRepo
            .createQueryBuilder('p')
            .leftJoin('role_permissions', 'rp', 'rp.permissionId = p.id')
            .where('rp.id IS NULL')
            .getCount();

        console.log(`   Permissions sans rôles: ${orphanPermissions}`);

        // Vérifier les incohérences de rôle principal
        const usersWithMultiplePrincipalRoles = await this.utilisateurRoleRepo
            .createQueryBuilder('ur')
            .select('ur.utilisateurId')
            .addSelect('COUNT(*)', 'count')
            .where('ur.estPrincipal = :principal', { principal: true })
            .groupBy('ur.utilisateurId')
            .having('COUNT(*) > 1')
            .getRawMany();

        if (usersWithMultiplePrincipalRoles.length > 0) {
            console.log(`\n   ⚠️  ${usersWithMultiplePrincipalRoles.length} utilisateurs avec plusieurs rôles principaux`);
            
            if (MIGRATION_CONFIG.verbose) {
                for (const row of usersWithMultiplePrincipalRoles) {
                    console.log(`      - Utilisateur ID: ${row.utilisateurId} (${row.count} rôles principaux)`);
                }
            }
        } else {
            console.log(`\n   ✅ Aucune incohérence détectée`);
        }

        console.log('');
    }

    /**
     * Générer un rapport de migration
     */
    private async generateReport(): Promise<void> {
        console.log('📋 Rapport de migration:\n');

        const totalUsers = await this.utilisateurRepo.count();
        const totalUtilisateurRoles = await this.utilisateurRoleRepo.count();
        
        // Statistiques par rôle
        const roleStats = await this.utilisateurRoleRepo
            .createQueryBuilder('ur')
            .leftJoin('roles', 'r', 'r.id = ur.roleId')
            .select('r.libelle', 'role')
            .addSelect('r.code', 'code')
            .addSelect('COUNT(*)', 'count')
            .groupBy('r.libelle')
            .addGroupBy('r.code')
            .orderBy('count', 'DESC')
            .getRawMany();

        console.log('   Distribution des rôles:');
        for (const stat of roleStats) {
            const percentage = ((parseInt(stat.count) / totalUtilisateurRoles) * 100).toFixed(1);
            console.log(`     - ${stat.role} (${stat.code}): ${stat.count} (${percentage}%)`);
        }

        console.log(`\n   Total: ${totalUtilisateurRoles} assignations pour ${totalUsers} utilisateurs`);
        console.log('');
    }
}

// ==================================
// EXÉCUTION
// ==================================

async function main(): Promise<void> {
    try {
        // Connexion à la base de données
        await AppDataSource.initialize();
        console.log('✅ Connecté à la base de données\n');

        // Exécuter la migration
        const migrationService = new RBACMigrationService();
        await migrationService.migrate();

        // Fermer la connexion
        await AppDataSource.destroy();
        
        process.exit(0);
    } catch (error) {
        console.error('Migration échouée:', error);
        process.exit(1);
    }
}

// Lancer la migration
main();
