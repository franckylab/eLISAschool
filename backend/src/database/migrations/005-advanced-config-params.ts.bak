/**
 * ==================================
 * eLISAschool - Migration: Paramètres de Configuration Avancés
 * ==================================
 * Version: 1.0.0
 * Date: 2025-06-06
 * 
 * Ajoute 30+ paramètres manquants identifiés lors de l'audit
 */

import { AppDataSource } from '../data-source';
import { ParametreSysteme, CategorieParametre, TypeValeurParametre } from '../../modules/configuration/entities/parametre-systeme.entity';

async function runMigration() {
    console.log('🚀 Démarrage migration: Paramètres de configuration avancés...');

    const dataSource = await AppDataSource.initialize();
    const parametreRepo = dataSource.getRepository(ParametreSysteme);

    const nouveauxParametres = [
        // ========== BULLETINS (6 paramètres) ==========
        {
            cle: 'bulletins.include_ranking',
            valeur: JSON.stringify(true),
            typeValeur: TypeValeurParametre.BOOLEAN,
            categorie: CategorieParametre.MODULE,
            module: 'bulletins',
            description: 'Afficher le classement sur les bulletins',
            valeurDefaut: JSON.stringify(true),
            modifiableRuntime: true,
            visible: true,
            ordre: 1,
        },
        {
            cle: 'bulletins.show_appreciations',
            valeur: JSON.stringify(true),
            typeValeur: TypeValeurParametre.BOOLEAN,
            categorie: CategorieParametre.MODULE,
            module: 'bulletins',
            description: 'Inclure les appréciations sur les bulletins',
            valeurDefaut: JSON.stringify(true),
            modifiableRuntime: true,
            visible: true,
            ordre: 2,
        },
        {
            cle: 'bulletins.validation_threshold',
            valeur: JSON.stringify(10),
            typeValeur: TypeValeurParametre.NUMBER,
            categorie: CategorieParametre.MODULE,
            module: 'bulletins',
            description: 'Seuil de validation des bulletins (sur 20)',
            valeurDefaut: JSON.stringify(10),
            modifiableRuntime: true,
            visible: true,
            ordre: 3,
        },
        {
            cle: 'bulletins.calculation_method',
            valeur: JSON.stringify('ponderee'),
            typeValeur: TypeValeurParametre.STRING,
            categorie: CategorieParametre.MODULE,
            module: 'bulletins',
            description: 'Méthode de calcul de la moyenne générale',
            valeurDefaut: JSON.stringify('ponderee'),
            modifiableRuntime: true,
            visible: true,
            ordre: 4,
            options: [
                { value: 'arithmetique', label: 'Arithmétique' },
                { value: 'ponderee', label: 'Pondérée' },
            ],
        },
        {
            cle: 'bulletins.display_coefficients',
            valeur: JSON.stringify(true),
            typeValeur: TypeValeurParametre.BOOLEAN,
            categorie: CategorieParametre.MODULE,
            module: 'bulletins',
            description: 'Afficher les coefficients sur les bulletins',
            valeurDefaut: JSON.stringify(true),
            modifiableRuntime: true,
            visible: true,
            ordre: 5,
        },
        {
            cle: 'bulletins.template_id',
            valeur: JSON.stringify('default'),
            typeValeur: TypeValeurParametre.STRING,
            categorie: CategorieParametre.MODULE,
            module: 'bulletins',
            description: 'Template PDF par défaut pour les bulletins',
            valeurDefaut: JSON.stringify('default'),
            modifiableRuntime: true,
            visible: true,
            ordre: 6,
        },

        // ========== ÉLÈVES (6 paramètres) ==========
        {
            cle: 'eleves.auto_generate_matricule',
            valeur: JSON.stringify(true),
            typeValeur: TypeValeurParametre.BOOLEAN,
            categorie: CategorieParametre.MODULE,
            module: 'eleves',
            description: 'Générer automatiquement le matricule élève',
            valeurDefaut: JSON.stringify(true),
            modifiableRuntime: true,
            visible: true,
            ordre: 1,
        },
        {
            cle: 'eleves.matricule_prefix',
            valeur: JSON.stringify('EL'),
            typeValeur: TypeValeurParametre.STRING,
            categorie: CategorieParametre.MODULE,
            module: 'eleves',
            description: 'Préfixe du matricule élève',
            valeurDefaut: JSON.stringify('EL'),
            modifiableRuntime: true,
            visible: true,
            ordre: 2,
        },
        {
            cle: 'eleves.max_per_class',
            valeur: JSON.stringify(50),
            typeValeur: TypeValeurParametre.NUMBER,
            categorie: CategorieParametre.MODULE,
            module: 'eleves',
            description: 'Nombre maximum d\'élèves par classe',
            valeurDefaut: JSON.stringify(50),
            modifiableRuntime: true,
            visible: true,
            ordre: 3,
        },
        {
            cle: 'eleves.photo_required',
            valeur: JSON.stringify(false),
            typeValeur: TypeValeurParametre.BOOLEAN,
            categorie: CategorieParametre.MODULE,
            module: 'eleves',
            description: 'Photo obligatoire pour les élèves',
            valeurDefaut: JSON.stringify(false),
            modifiableRuntime: true,
            visible: true,
            ordre: 4,
        },
        {
            cle: 'eleves.parent_contact_required',
            valeur: JSON.stringify(true),
            typeValeur: TypeValeurParametre.BOOLEAN,
            categorie: CategorieParametre.MODULE,
            module: 'eleves',
            description: 'Contact parent/tuteur obligatoire',
            valeurDefaut: JSON.stringify(true),
            modifiableRuntime: true,
            visible: true,
            ordre: 5,
        },

        // ========== SYSTÈME GLOBAL (5 paramètres) ==========
        {
            cle: 'system.date_format',
            valeur: JSON.stringify('DD/MM/YYYY'),
            typeValeur: TypeValeurParametre.STRING,
            categorie: CategorieParametre.SYSTEME,
            description: 'Format d\'affichage des dates',
            valeurDefaut: JSON.stringify('DD/MM/YYYY'),
            modifiableRuntime: true,
            visible: true,
            ordre: 5,
            options: [
                { value: 'DD/MM/YYYY', label: 'Jour/Mois/Année' },
                { value: 'MM/DD/YYYY', label: 'Mois/Jour/Année' },
                { value: 'YYYY-MM-DD', label: 'Année-Mois-Jour' },
            ],
        },
        {
            cle: 'system.time_format',
            valeur: JSON.stringify('24h'),
            typeValeur: TypeValeurParametre.STRING,
            categorie: CategorieParametre.SYSTEME,
            description: 'Format d\'affichage de l\'heure',
            valeurDefaut: JSON.stringify('24h'),
            modifiableRuntime: true,
            visible: true,
            ordre: 6,
            options: [
                { value: '24h', label: '24h (14:30)' },
                { value: '12h', label: '12h (2:30 PM)' },
            ],
        },
        {
            cle: 'system.pagination_default',
            valeur: JSON.stringify(20),
            typeValeur: TypeValeurParametre.NUMBER,
            categorie: CategorieParametre.SYSTEME,
            description: 'Nombre d\'éléments par page par défaut',
            valeurDefaut: JSON.stringify(20),
            modifiableRuntime: true,
            visible: true,
            ordre: 7,
        },
        {
            cle: 'system.export_format',
            valeur: JSON.stringify('pdf'),
            typeValeur: TypeValeurParametre.STRING,
            categorie: CategorieParametre.SYSTEME,
            description: 'Format d\'export par défaut',
            valeurDefaut: JSON.stringify('pdf'),
            modifiableRuntime: true,
            visible: true,
            ordre: 8,
            options: [
                { value: 'pdf', label: 'PDF' },
                { value: 'excel', label: 'Excel' },
                { value: 'csv', label: 'CSV' },
            ],
        },

        // ========== MESSAGERIE AVANCÉ (4 paramètres) ==========
        {
            cle: 'messagerie.auto_archive_days',
            valeur: JSON.stringify(90),
            typeValeur: TypeValeurParametre.NUMBER,
            categorie: CategorieParametre.MODULE,
            module: 'messagerie',
            description: 'Archivage automatique des messages après X jours',
            valeurDefaut: JSON.stringify(90),
            modifiableRuntime: true,
            visible: true,
            ordre: 5,
        },
        {
            cle: 'messagerie.read_receipts',
            valeur: JSON.stringify(true),
            typeValeur: TypeValeurParametre.BOOLEAN,
            categorie: CategorieParametre.MODULE,
            module: 'messagerie',
            description: 'Activer les confirmations de lecture',
            valeurDefaut: JSON.stringify(true),
            modifiableRuntime: true,
            visible: true,
            ordre: 6,
        },
        {
            cle: 'messagerie.message_edit_window',
            valeur: JSON.stringify(15),
            typeValeur: TypeValeurParametre.NUMBER,
            categorie: CategorieParametre.MODULE,
            module: 'messagerie',
            description: 'Fenêtre d\'édition des messages (minutes)',
            valeurDefaut: JSON.stringify(15),
            modifiableRuntime: true,
            visible: true,
            ordre: 7,
        },

        // ========== GAMIFICATION AVANCÉ (4 paramètres) ==========
        {
            cle: 'gamification.points_late_arrival',
            valeur: JSON.stringify(-2),
            typeValeur: TypeValeurParametre.NUMBER,
            categorie: CategorieParametre.MODULE,
            module: 'gamification',
            description: 'Points pour retard (négatif)',
            valeurDefaut: JSON.stringify(-2),
            modifiableRuntime: true,
            visible: true,
            ordre: 5,
        },
        {
            cle: 'gamification.points_absence',
            valeur: JSON.stringify(-5),
            typeValeur: TypeValeurParametre.NUMBER,
            categorie: CategorieParametre.MODULE,
            module: 'gamification',
            description: 'Points pour absence (négatif)',
            valeurDefaut: JSON.stringify(-5),
            modifiableRuntime: true,
            visible: true,
            ordre: 6,
        },
        {
            cle: 'gamification.reset_frequency',
            valeur: JSON.stringify('trimestriel'),
            typeValeur: TypeValeurParametre.STRING,
            categorie: CategorieParametre.MODULE,
            module: 'gamification',
            description: 'Fréquence de réinitialisation des points',
            valeurDefaut: JSON.stringify('trimestriel'),
            modifiableRuntime: true,
            visible: true,
            ordre: 7,
            options: [
                { value: 'mensuel', label: 'Mensuel' },
                { value: 'trimestriel', label: 'Trimestriel' },
                { value: 'annuel', label: 'Annuel' },
            ],
        },
    ];

    let created = 0;
    let skipped = 0;

    for (const param of nouveauxParametres) {
        const existing = await parametreRepo.findOne({ where: { cle: param.cle } });
        
        if (existing) {
            console.log(`⏭️  Paramètre existe déjà: ${param.cle}`);
            skipped++;
            continue;
        }

        const entity = parametreRepo.create(param);
        await parametreRepo.save(entity);
        console.log(`✅ Créé: ${param.cle}`);
        created++;
    }

    console.log('\n📊 Résumé:');
    console.log(`   ✅ Créés: ${created}`);
    console.log(`   ⏭️  Ignorés: ${skipped}`);
    console.log(`   📦 Total: ${nouveauxParametres.length}`);

    await dataSource.destroy();
    console.log('\n✨ Migration terminée avec succès!');
}

// Exécuter la migration
runMigration().catch((error) => {
    console.error('❌ Erreur migration:', error);
    process.exit(1);
});
