{
    "name": "@elisaschool/backend",
    "version": "1.0.0",
    "description": "API Backend eLISAschool - Express.js avec TypeScript",
    "author": "xAI Éducation",
    "license": "UNLICENSED",
    "private": true,
    "main": "dist/index.js",
    "scripts": {
        "dev": "nodemon --exec ts-node -r tsconfig-paths/register src/index.ts",
        "build": "tsc && tsc-alias",
        "start": "node dist/index.js",
        "lint": "eslint src --ext .ts",
        "lint:fix": "eslint src --ext .ts --fix",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "migration:generate": "typeorm migration:generate -d src/database/data-source.ts",
        "migration:run": "typeorm migration:run -d src/database/data-source.ts",
        "migration:revert": "typeorm migration:revert -d src/database/data-source.ts",
        "seed": "ts-node -r tsconfig-paths/register src/database/seeds/run-seeds.ts"
    },
    "dependencies": {
        "bcryptjs": "^2.4.3",
        "compression": "^1.7.4",
        "cors": "^2.8.5",
        "dotenv": "^16.4.7",
        "express": "^4.21.2",
        "express-rate-limit": "^7.4.1",
        "helmet": "^8.0.0",
        "jsonwebtoken": "^9.0.2",
        "pg": "^8.13.1",
        "qrcode": "^1.5.4",
        "reflect-metadata": "^0.2.2",
        "typeorm": "^0.3.20",
        "uuid": "^11.0.3",
        "winston": "^3.17.0",
        "zod": "^3.24.1"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/compression": "^1.7.5",
        "@types/cors": "^2.8.17",
        "@types/express": "^5.0.0",
        "@types/jest": "^29.5.14",
        "@types/jsonwebtoken": "^9.0.7",
        "@types/node": "^22.10.2",
        "@types/qrcode": "^1.5.5",
        "@types/uuid": "^10.0.0",
        "@typescript-eslint/eslint-plugin": "^8.18.0",
        "@typescript-eslint/parser": "^8.18.0",
        "eslint": "^9.17.0",
        "jest": "^29.7.0",
        "nodemon": "^3.1.7",
        "ts-jest": "^29.2.5",
        "ts-node": "^10.9.2",
        "tsc-alias": "^1.8.10",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.7.2"
    }
}