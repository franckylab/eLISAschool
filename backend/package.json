{
    "name": "@elisaschool/backend",
    "version": "1.0.0",
    "description": "API Backend eLISAschool - Express.js avec TypeScript",
    "author": "franck arlos chendjou",
    "license": "UNLICENSED",
    "private": true,
    "main": "dist/index.js",
    "scripts": {
        "dev": "nodemon --exec ts-node --transpile-only -r tsconfig-paths/register src/index.ts",
        "build": "tsc || true",
        "start": "node dist/index.js || npx ts-node --transpile-only -r tsconfig-paths/register src/index.ts",
        "start:ts": "npx ts-node --transpile-only -r tsconfig-paths/register src/index.ts",
        "lint": "eslint src --ext .ts",
        "lint:fix": "eslint src --ext .ts --fix",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "test:phase1": "ts-node -r tsconfig-paths/register scripts/test-phase1-contexte-africain.ts",
        "migration:generate": "typeorm migration:generate -d src/database/data-source.ts",
        "migration:run": "typeorm migration:run -d src/database/data-source.ts",
        "migration:revert": "typeorm migration:revert -d src/database/data-source.ts",
        "migration:fix-indexes": "ts-node -r tsconfig-paths-register scripts/analyze-indexes.ts",
        "seed": "ts-node -r tsconfig-paths/register src/database/seeds/run-seeds.ts",
        "seed:check": "ts-node -r tsconfig-paths/register src/database/scripts/check-seeds-status.ts",
        "seed:rbac": "ts-node -r tsconfig-paths/register src/database/seeds/run-rbac-seed.ts",
        "seed:demo": "ts-node -r tsconfig-paths/register src/database/seeds/run-demo-seeds.ts",
        "db:analyze-indexes": "ts-node -r tsconfig-paths/register scripts/analyze-indexes.ts",
        "db:fix-duplicate-index": "./scripts/fix-duplicate-index.sh"
    },
    "dependencies": {
        "@casl/ability": "^6.8.1",
        "@simplewebauthn/server": "^10.0.0",
        "@types/node-cron": "^3.0.11",
        "bcryptjs": "^2.4.3",
        "compression": "^1.7.4",
        "cors": "^2.8.5",
        "dotenv": "^16.4.7",
        "express": "^4.21.2",
        "express-rate-limit": "^7.4.1",
        "firebase-admin": "^13.10.0",
        "helmet": "^8.0.0",
        "ioredis": "^5.4.1",
        "jsonwebtoken": "^9.0.2",
        "multer": "^2.2.0",
        "node-cron": "^4.2.1",
        "nodemailer": "^8.0.10",
        "pg": "^8.13.1",
        "qrcode": "^1.5.4",
        "reflect-metadata": "^0.2.2",
        "sharp": "^0.35.2",
        "socket.io": "^4.7.5",
        "swagger-ui-express": "^5.0.1",
        "twilio": "^6.0.2",
        "typeorm": "^0.3.20",
        "ua-parser-js": "^2.0.10",
        "uuid": "^11.0.3",
        "winston": "^3.17.0",
        "zod": "^3.24.1"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/compression": "^1.7.5",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/glob": "^8.1.0",
        "@types/ioredis": "^5.0.0",
        "@types/jest": "^29.5.14",
        "@types/jsonwebtoken": "^9.0.7",
        "@types/multer": "^2.2.0",
        "@types/node": "^22.10.2",
        "@types/nodemailer": "^8.0.0",
        "@types/pg": "^8.20.0",
        "@types/qrcode": "^1.5.5",
        "@types/swagger-ui-express": "^4.1.8",
        "@types/ua-parser-js": "^0.7.39",
        "@types/uuid": "^10.0.0",
        "@typescript-eslint/eslint-plugin": "^8.18.0",
        "@typescript-eslint/parser": "^8.18.0",
        "eslint": "^9.17.0",
        "jest": "^29.7.0",
        "nodemon": "^3.1.7",
        "ts-jest": "^29.2.5",
        "ts-node": "^10.9.2",
        "tsc-alias": "^1.8.10",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.7.2",
        "typescript-eslint": "^8.60.1"
    }
}
