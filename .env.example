# ==================================
# eLISAschool - Variables d'Environnement
# ==================================
# Copiez ce fichier en .env et remplissez les valeurs

# Application
NODE_ENV=development
APP_NAME=eLISAschool
APP_VERSION=1.0.0
APP_PORT=7000
APP_URL=http://localhost:7000

# Base de données PostgreSQL
DB_HOST=localhost
DB_PORT=7002
DB_NAME=elisaschool
DB_USER=elisaschool_user
DB_PASSWORD=votre_mot_de_passe_securise

# JWT Authentication
JWT_SECRET=votre_cle_secrete_jwt_256_bits_minimum
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Chiffrement AES-256
ENCRYPTION_KEY=votre_cle_aes_256_32_caracteres

# Redis (Cache distribué & files d'attente)
# Docker : utiliser 'redis' comme host
# Local : utiliser 'localhost'
REDIS_HOST=localhost
REDIS_PORT=7003
REDIS_PASSWORD=

# pgAdmin 4 (Administration PostgreSQL)
PGADMIN_PORT=7004
PGADMIN_EMAIL=admin@elisaschool.cm
PGADMIN_PASSWORD=admin123

# Production : définir un mot de passe fort (min 32 caractères)
# REDIS_PASSWORD=votre_mot_de_passe_redis_tres_securise

# Email (Notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@elisaschool.cm

# SMS (Twilio - Optionnel)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Push Notifications (Firebase FCM - Optionnel)
FIREBASE_PROJECT_ID=
FIREBASE_SERVER_KEY=
FIREBASE_VAPID_KEY=

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:7001
# Origines supplémentaires autorisées (séparées par des virgules)
# Exemple: ALLOWED_ORIGINS=http://10.0.0.1:7001,http://192.168.1.100:7001
ALLOWED_ORIGINS=

# Licence
LICENSE_KEY=

# Logging
LOG_LEVEL=debug
LOG_FILE=logs/app.log

# Cron Jobs (activés en développement)
ENABLE_CRON_JOBS=true
