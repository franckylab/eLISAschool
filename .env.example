# ==================================
# eLISAschool - Variables d'Environnement
# ==================================
# Copiez ce fichier en .env et remplissez les valeurs

# Application
NODE_ENV=development
APP_NAME=eLISAschool
APP_VERSION=1.0.0
APP_PORT=3000
APP_URL=http://localhost:3000

# Base de données PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=elisaschool
DB_USER=elisaschool_user
DB_PASSWORD=votre_mot_de_passe_securise

# JWT Authentication
JWT_SECRET=votre_cle_secrete_jwt_256_bits_minimum
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Chiffrement AES-256
ENCRYPTION_KEY=votre_cle_aes_256_32_caracteres

# Redis (Synchronisation)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Email (Notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@elisaschool.cm

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:5173

# Licence
LICENSE_KEY=

# Logging
LOG_LEVEL=debug
LOG_FILE=logs/app.log
