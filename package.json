{
  "name": "elisaschool",
  "version": "1.0.0",
  "description": "PWA de gestion avanc\u00e9e d'\u00e9tablissements scolaires - eLISAschool",
  "author": "xAI \u00c9ducation",
  "license": "UNLICENSED",
  "private": true,
  "workspaces": [
    "backend",
    "frontend",
    "shared"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=backend & npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspaces",
    "build:backend": "npm run build --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces",
    "db:migrate": "npm run migration:run --workspace=backend",
    "db:seed": "npm run seed --workspace=backend",
    "docker:dev": "docker compose -f docker-compose.dev.yml up -d",
    "docker:dev:build": "docker compose -f docker-compose.dev.yml up -d --build",
    "docker:dev:logs": "docker compose -f docker-compose.dev.yml logs -f",
    "docker:dev:down": "docker compose -f docker-compose.dev.yml down",
    "docker:dev:restart": "docker compose -f docker-compose.dev.yml restart backend",
    "docker:prod": "docker compose up -d",
    "docker:prod:build": "docker compose up -d --build",
    "docker:prod:logs": "docker compose logs -f",
    "docker:prod:down": "docker compose down",
    "docker:down": "docker compose -f docker-compose.dev.yml down && docker compose down",
    "docker:clean": "docker compose -f docker-compose.dev.yml down -v && docker compose down -v",
    "postinstall": "rm -rf node_modules/@types/express/node_modules/@types/express-serve-static-core"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "@types/express": "4.17.21",
    "@types/express-serve-static-core": "4.17.31"
  }
}